<Window x:Class="PptPngExporter.App.Views.PageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PptPngExporter.App.ViewModels"
        Title="挑選要輸出的頁面"
        Height="760" Width="1040" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="挑選要輸出的頁面" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全部選取" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" />
                <Button Content="全部取消" Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlideGroup}">
                                <StackPanel Margin="0,0,0,20">

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource SectionTitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="本份全選" Style="{StaticResource GhostButton}"
                                                    Command="{Binding SelectAllCommand}" />
                                            <Button Content="本份全不選" Style="{StaticResource GhostButton}"
                                                    Command="{Binding SelectNoneCommand}" />
                                            <Button Content="反選" Style="{StaticResource GhostButton}"
                                                    Command="{Binding InvertCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Slides}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SlideThumbnail}">
                                                <Border x:Name="Card" Width="212" Margin="0,0,10,10"
                                                        CornerRadius="8" Padding="5"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush2}"
                                                        BorderThickness="2"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="OnThumbnailClick">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Border CornerRadius="4" ClipToBounds="True"
                                                                    Background="White" MinHeight="80">
                                                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                                            </Border>

                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Margin="6" CornerRadius="4" Padding="6,2"
                                                                    Background="{StaticResource InkBrush}" Opacity="0.85">
                                                                <TextBlock Text="{Binding PageLabel}" FontSize="11"
                                                                           FontWeight="SemiBold" Foreground="White" />
                                                            </Border>

                                                            <Border x:Name="Tick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="6" Width="22" Height="22" CornerRadius="11"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    Visibility="Collapsed">
                                                                <Path Data="M 5 11 L 9 15 L 17 6" Stroke="White" StrokeThickness="2.2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                        <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="#F2FFFFFF"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                        <TextBlock Text="正在產生預覽縮圖" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="第一次預覽需要轉換整份簡報，之後會直接使用快取。"
                                   Style="{StaticResource HintText}" Margin="0,6,0,14"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <ProgressBar Style="{StaticResource AppProgressBar}" Minimum="0" Maximum="100"
                                     Value="{Binding LoadProgress, Mode=OneWay}" />
                        <TextBlock Text="{Binding LoadingText}" Style="{StaticResource HintText}"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="停止" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center" Margin="0,14,0,0"
                                Command="{Binding CancelLoadingCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource HintText}"
                       Text="點縮圖即可切換勾選。輸出檔名會依勾選順序連續編號（可在主畫面改成沿用原始頁碼）。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="OnCancel" IsCancel="True" />
                <Button Content="套用挑選" Style="{StaticResource PrimaryButton}"
                        Click="OnConfirm" IsEnabled="{Binding IsReady}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
