<Window x:Class="PptPngExporter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PptPngExporter.App.ViewModels"
        Title="PPT PNG 匯出工具"
        Height="770" Width="1140" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        Closing="OnWindowClosing"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="18,16,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 標題列 ==================== -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 標誌：一張投影片，下方是投影機的光 -->
            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                    Background="{StaticResource InkBrush}" VerticalAlignment="Center">
                <Canvas Width="42" Height="42">
                    <Border Canvas.Left="8" Canvas.Top="10" Width="26" Height="15"
                            CornerRadius="2" Background="White" />
                    <Rectangle Canvas.Left="11" Canvas.Top="14" Width="14" Height="2" Fill="#C6CFDD" />
                    <Rectangle Canvas.Left="11" Canvas.Top="18" Width="9" Height="2" Fill="#C6CFDD" />
                    <Path Fill="#D9821A" Data="M 21 28 L 13 35 L 29 35 Z" />
                </Canvas>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PPT PNG 匯出工具" Style="{StaticResource TitleText}" />
                <TextBlock Text="把每一份簡報的每一頁，存成一張高畫質 PNG 圖片。"
                           Style="{StaticResource HintText}" Margin="0,2,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Content="轉換記錄" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center"
                    Command="{Binding OpenLogCommand}"
                    ToolTip="開啟記錄檔資料夾，回報問題時可以一併提供" />
        </Grid>

        <!-- ==================== 主要內容 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- 左：簡報清單 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="簡報清單" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="加入簡報" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddFilesCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 清單操作 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                        <Button Content="全選" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" />
                        <Button Content="取消全選" Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}" />
                        <Border Width="1" Background="{StaticResource BorderBrush2}" Margin="6,4" />
                        <Button Content="移除勾選的" Style="{StaticResource GhostButton}" Command="{Binding RemoveSelectedCommand}" />
                        <Button Content="清空清單" Style="{StaticResource GhostButton}" Command="{Binding ClearAllCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="FileList"
                                 Style="{StaticResource FileListBox}"
                                 ItemContainerStyle="{StaticResource FileListItem}"
                                 ItemsSource="{Binding Files}"
                                 MouseDoubleClick="OnFileListDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresentationItem}">
                                    <Grid Margin="12,10,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource AppCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  ToolTip="勾選要轉換的簡報" />

                                        <Border Grid.Column="1" Width="46" Height="22" CornerRadius="5"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding FolderPath}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="330" />
                                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           Visibility="{Binding PageSelectionSummary, Converter={StaticResource NotEmptyToVis}}" />
                                                <TextBlock Text="{Binding PageSelectionSummary}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding PageSelectionSummary, Converter={StaticResource NotEmptyToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Style="{StaticResource ErrorText}"
                                                       Margin="0,4,8,0"
                                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="12,0,8,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToDot}}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        </StackPanel>

                                        <Button Grid.Column="4" Content="開啟資料夾"
                                                Style="{StaticResource GhostButton}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空清單時的引導 -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="把簡報拖進這裡" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="也可以按右上角的「加入簡報」，或直接拖一整個資料夾進來。"
                                           Style="{StaticResource HintText}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="支援 .ppt、.pptx、.pps、.ppsx"
                                           Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：設定 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding IsIdle}" Padding="0,0,4,0">
                <StackPanel>

                    <!-- 頁面範圍 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="要轉換哪些頁面" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                            <RadioButton Content="全部頁面" Style="{StaticResource AppRadioButton}"
                                         GroupName="Pages" IsChecked="{Binding UseAllPages, Mode=TwoWay}" />
                            <RadioButton Content="輸入頁碼範圍" Style="{StaticResource AppRadioButton}"
                                         GroupName="Pages" IsChecked="{Binding UseCustomPages, Mode=TwoWay}" />

                            <TextBox Style="{StaticResource AppTextBox}"
                                     Margin="26,2,0,0"
                                     Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCustomPages}" />

                            <TextBlock Style="{StaticResource HintText}" Margin="26,6,0,12"
                                       Text="用逗號分隔，連續頁碼用「-」。例如 1-5,8,12-15" />

                            <RadioButton Content="看縮圖逐頁勾選" Style="{StaticResource AppRadioButton}"
                                         GroupName="Pages" IsChecked="{Binding UsePickedPages, Mode=TwoWay}" />

                            <Button Content="開啟縮圖挑選頁面" Style="{StaticResource SecondaryButton}"
                                    Margin="26,2,0,0" HorizontalAlignment="Left"
                                    Command="{Binding OpenPagePickerCommand}" />
                            <TextBlock Text="{Binding PickedSummary}" Style="{StaticResource HintText}"
                                       Margin="26,6,0,0" />

                            <TextBlock Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                                       Text="{Binding PageRangeError}"
                                       Visibility="{Binding PageRangeError, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- 圖片大小 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="圖片寬度" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                         Text="{Binding ImageWidthText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" Text="像素" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="1280" Style="{StaticResource ChipButton}" Click="OnWidthPresetClick" Tag="1280" />
                                <Button Content="1920" Style="{StaticResource ChipButton}" Click="OnWidthPresetClick" Tag="1920" />
                                <Button Content="2560" Style="{StaticResource ChipButton}" Click="OnWidthPresetClick" Tag="2560" />
                                <Button Content="3840" Style="{StaticResource ChipButton}" Click="OnWidthPresetClick" Tag="3840" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       Text="高度會依簡報比例自動計算，不會變形。"
                                       Visibility="{Binding ImageWidthError, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}" />
                            <TextBlock Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                                       Text="{Binding ImageWidthError}"
                                       Visibility="{Binding ImageWidthError, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- 檔名與輸出位置 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="檔名與存放位置" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                            <TextBlock Text="檔名前綴" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Text="{Binding FileNamePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="編號方式" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <RadioButton Content="依輸出順序連續編號" Style="{StaticResource AppRadioButton}"
                                         GroupName="Numbering" IsChecked="{Binding NumberingSequential, Mode=TwoWay}" />
                            <RadioButton Content="沿用原始頁碼" Style="{StaticResource AppRadioButton}"
                                         GroupName="Numbering" IsChecked="{Binding NumberingOriginal, Mode=TwoWay}" />

                            <TextBlock Text="編號位數" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="自動" Style="{StaticResource ChipButton}" Click="OnDigitsPresetClick" Tag="0" />
                                <Button Content="01" Style="{StaticResource ChipButton}" Click="OnDigitsPresetClick" Tag="2" />
                                <Button Content="001" Style="{StaticResource ChipButton}" Click="OnDigitsPresetClick" Tag="3" />
                                <Button Content="0001" Style="{StaticResource ChipButton}" Click="OnDigitsPresetClick" Tag="4" />
                            </StackPanel>

                            <Border CornerRadius="7" Padding="10,8" Margin="0,10,0,0"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <TextBlock Text="{Binding FileNamePreview}" Style="{StaticResource HintText}" />
                            </Border>

                            <TextBlock Text="存放位置" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                                         Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding OutputFolder}" />
                                <Button Grid.Column="1" Content="瀏覽…" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Text="每份簡報會存到自己的資料夾。同名時會自動加上編號，不會覆蓋既有檔案。" />
                        </StackPanel>
                    </Border>

                    <!-- 轉換方式 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="轉換方式" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                            <RadioButton Content="自動（建議）" Style="{StaticResource AppRadioButton}"
                                         GroupName="Engine" IsChecked="{Binding IsEngineAuto, Mode=TwoWay}" />
                            <RadioButton Content="只用 PowerPoint" Style="{StaticResource AppRadioButton}"
                                         GroupName="Engine" IsChecked="{Binding IsEnginePowerPoint, Mode=TwoWay}" />
                            <RadioButton Content="只用 LibreOffice" Style="{StaticResource AppRadioButton}"
                                         GroupName="Engine" IsChecked="{Binding IsEngineLibreOffice, Mode=TwoWay}" />

                            <Border CornerRadius="7" Padding="10,8" Margin="0,4,0,0"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource HintText}" />
                                    <Button Content="重新偵測" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="-10,4,0,0"
                                            Command="{Binding RecheckEnginesCommand}"
                                            ToolTip="剛安裝好 PowerPoint 或 LibreOffice 時按這裡，不用重開程式" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="7" Padding="12,10" Margin="0,10,0,0"
                                    Background="{StaticResource DangerSoftBrush}"
                                    Visibility="{Binding NoEngineAvailable, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="還不能開始轉換" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="轉換簡報需要 Microsoft PowerPoint 或 LibreOffice，這台電腦兩個都沒有。LibreOffice 是免費的，通常不需要系統管理員權限就能安裝。" />
                                    <Button Content="下載 LibreOffice" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Command="{Binding DownloadLibreOfficeCommand}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="裝好之後回到這裡按「重新偵測」即可。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部動作列 ==================== -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="18,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="10,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 進度 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Style="{StaticResource AppProgressBar}"
                                 Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource HintText}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource InkBrush}"
                                   Visibility="{Binding SummaryText, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="失敗的檔案不會影響其他檔案，錯誤原因會顯示在清單裡。"
                                   Visibility="{Binding LastRunHadFailures, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="開啟輸出資料夾" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Command="{Binding OpenOutputCommand}" />
                        <Button Content="停止" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Button Content="開始轉換" Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
