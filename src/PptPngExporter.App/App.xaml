<Application x:Class="PptPngExporter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:PptPngExporter.App.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <inf:BoolToVisibilityConverter x:Key="BoolToVis" />
            <inf:InverseBoolConverter x:Key="InvBool" />
            <inf:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
            <inf:StatusToBrushConverter x:Key="StatusToBrush" />
            <inf:StatusToDotConverter x:Key="StatusToDot" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
